{
  "name": "@amita/codemode-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --config wrangler.jsonc --dry-run --outdir ../../dist/codemode",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc --port 8788 --inspector-port 0 --persist-to ../../.wrangler/state"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.0"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  }
}
